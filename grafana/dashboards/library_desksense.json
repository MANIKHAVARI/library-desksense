  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current Occupancy",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "library-desksense-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "library-desksense-influx"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"desk_telemetry\")\n  |> filter(fn: (r) => r._field == \"occupied\")\n  |> group(columns: [])\n  |> last()\n  |> map(fn: (r) => ({ r with _field: \"Current Occupancy\" }))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "FREE"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "OCCUPIED"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "pluginVersion": "11.0.0"
    },
